<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<DialogPane styleClass="dialogPane" stylesheets="@../../../css/dialogPane.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.admin.adminDialog.ChangeStudentGroupDialogController">
   <content>
      <Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="600.0" style="-fx-background-color: #fff;">
         <children>
            <AnchorPane layoutX="20.0" layoutY="65.0" prefHeight="200.0" prefWidth="560.0" style="-fx-border-color: #e8d58c; -fx-border-radius: 5; -fx-border-width: 2;">
               <children>
                  <Label layoutX="21.0" layoutY="62.0" text="Поточна група: ">
                     <font>
                        <Font name="Gotham-Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label fx:id="GroupNameLabel" layoutX="195.0" layoutY="62.0" text="Група">
                     <font>
                        <Font name="Gotham-Bold" size="20.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="groupComboBox" layoutX="227.0" layoutY="120.0" prefWidth="225.0" styleClass="comboBox" stylesheets="@../../../css/textField.css" />
                  <Label layoutX="34.0" layoutY="126.0" text="Виберіть групу">
                     <font>
                        <Font name="Gotham-Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label layoutX="21.0" layoutY="21.0" text="Студент:">
                     <font>
                        <Font name="Gotham-Bold" size="20.0" />
                     </font>
                  </Label>
                  <Label fx:id="StudentLabel" layoutX="125.0" layoutY="21.0" text="Студент">
                     <font>
                        <Font name="Gotham-Bold" size="20.0" />
                     </font>
                  </Label>
               </children></AnchorPane>
            <Button fx:id="applyButton" layoutX="450.0" layoutY="275.0" mnemonicParsing="false" onAction="#changeStudentGroup" styleClass="Button" stylesheets="@../../../css/button.css" text="підтвердити" />
            <Button fx:id="cancelButton" layoutX="20.0" layoutY="275.0" mnemonicParsing="false" onAction="#closeDialog" styleClass="Button" stylesheets="@../../../css/button.css" text="скасувати" />
            <Label layoutX="165.0" layoutY="14.0" text="Змінити групу">
               <font>
                  <Font name="Kharkiv Tone Regular" size="32.0" />
               </font>
            </Label>
         </children>
      </Pane>
   </content>
</DialogPane>
